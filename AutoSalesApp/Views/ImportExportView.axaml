<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AutoSalesApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="AutoSalesApp.Views.ImportExportView"
             x:DataType="vm:ImportExportViewModel">

  <Design.DataContext>
    <vm:ImportExportViewModel/>
  </Design.DataContext>

  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">

    <StackPanel Grid.Row="0" Grid.Column="0" Margin="10" Spacing="12" Width="430">

      <!-- Импорт -->
      <TextBlock Text="Импорт данных" FontWeight="Bold" FontSize="14"/>

      <StackPanel Spacing="5">
        <TextBlock Text="CSV (разделитель ';', первая строка — заголовок):"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ComboBox Width="230" ItemsSource="{Binding CsvImportEntityNames}"
                    SelectedIndex="{Binding CsvImportEntityIndex}"/>
          <Button Content="Импорт CSV" Command="{Binding ImportCsvCommand}"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock Text="Excel (XLSX):"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ComboBox Width="230" ItemsSource="{Binding ExcelImportEntityNames}"
                    SelectedIndex="{Binding ExcelImportEntityIndex}"/>
          <Button Content="Импорт Excel" Command="{Binding ImportExcelCommand}"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Spacing="5">
        <TextBlock Text="Полная структура (все таблицы):"/>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Импорт JSON" Command="{Binding ImportJsonCommand}"/>
          <Button Content="Импорт XML" Command="{Binding ImportXmlCommand}"/>
        </StackPanel>
      </StackPanel>

      <!-- Экспорт -->
      <TextBlock Text="Экспорт данных" FontWeight="Bold" FontSize="14" Margin="0,10,0,0"/>

      <StackPanel Spacing="5">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ComboBox Width="230" ItemsSource="{Binding CsvExportEntityNames}"
                    SelectedIndex="{Binding CsvExportEntityIndex}"/>
          <Button Content="Экспорт CSV" Command="{Binding ExportCsvCommand}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Content="Экспорт Excel (все таблицы)" Command="{Binding ExportExcelCommand}"/>
          <Button Content="Экспорт PDF (отчёт + график)" Command="{Binding ExportPdfCommand}"/>
        </StackPanel>
      </StackPanel>

    </StackPanel>

    <!-- Журнал -->
    <Border Grid.Row="0" Grid.Column="1" Margin="10" BorderBrush="LightGray" BorderThickness="1">
      <DockPanel Margin="5">
        <TextBlock DockPanel.Dock="Top" Text="Журнал операций" FontWeight="Bold" Margin="0,0,0,5"/>
        <ScrollViewer>
          <TextBlock Text="{Binding Log}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
