<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AutoSalesApp.ViewModels"
             xmlns:model="using:AutoSalesApp.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AutoSalesApp.Views.ProducerView"
             x:DataType="vm:ProducerViewModel">

  <Design.DataContext>
    <vm:ProducerViewModel/>
  </Design.DataContext>

  <UserControl.Resources>
    <DataTemplate x:Key="producerTemplate" DataType="model:Producer">
      <Grid ColumnDefinitions="50,100,150,130,150,150">
        <TextBlock Grid.Column="0" Text="{Binding ProducerId}" Margin="5"/>
        <TextBlock Grid.Column="1" Text="{Binding CompanyCode}" Margin="5"/>
        <TextBlock Grid.Column="2" Text="{Binding CompanyName}" Margin="5"/>
        <TextBlock Grid.Column="3" Text="{Binding Phone}" Margin="5"/>
        <TextBlock Grid.Column="4" Text="{Binding Email}" Margin="5"/>
        <TextBlock Grid.Column="5" Text="{Binding Website}" Margin="5"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Форма добавления -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Spacing="10">
      <TextBox PlaceholderText="Код фирмы" Text="{Binding CompanyCode}" Width="120"/>
      <TextBox PlaceholderText="Название" Text="{Binding CompanyName}" Width="150"/>
      <TextBox PlaceholderText="Телефон" Text="{Binding Phone}" Width="130"/>
      <TextBox PlaceholderText="Email" Text="{Binding Email}" Width="150"/>
      <TextBox PlaceholderText="Web-сайт" Text="{Binding Website}" Width="150"/>
      <Button Content="Добавить" Command="{Binding AddCommand}"/>
    </StackPanel>

    <!-- Список -->
    <ListBox Grid.Row="1" Margin="10"
             ItemsSource="{Binding Producers}"
             ItemTemplate="{StaticResource producerTemplate}"
             SelectedItem="{Binding SelectedProducer}"/>

    <!-- Кнопки -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10" Spacing="10">
      <Button Content="Удалить выбранного" Command="{Binding DeleteCommand}"/>
      <Button Content="Обновить" Command="{Binding RefreshCommand}"/>
    </StackPanel>

  </Grid>
</UserControl>