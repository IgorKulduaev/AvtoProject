<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AutoSalesApp.ViewModels"
             xmlns:model="using:AutoSalesApp.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AutoSalesApp.Views.ModelView"
             x:DataType="vm:ModelViewModel">

  <Design.DataContext>
    <vm:ModelViewModel/>
  </Design.DataContext>

  <UserControl.Resources>
    <DataTemplate x:Key="modelTemplate" DataType="model:Model">
      <Grid ColumnDefinitions="50,100,150,80,120,80,120">
        <TextBlock Grid.Column="0" Text="{Binding ModelId}" Margin="5"/>
        <TextBlock Grid.Column="1" Text="{Binding ModelCode}" Margin="5"/>
        <TextBlock Grid.Column="2" Text="{Binding ModelName}" Margin="5"/>
        <TextBlock Grid.Column="3" Text="{Binding Color}" Margin="5"/>
        <TextBlock Grid.Column="4" Text="{Binding MotorPower}" Margin="5"/>
        <TextBlock Grid.Column="5" Text="{Binding DoorCount}" Margin="5"/>
        <TextBlock Grid.Column="6" Text="{Binding Transmission}" Margin="5"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Форма добавления -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Spacing="10">
      <TextBox PlaceholderText="Код модели" Text="{Binding ModelCode}" Width="100"/>
      <TextBox PlaceholderText="Название" Text="{Binding ModelName}" Width="150"/>
      <TextBox PlaceholderText="Цвет" Text="{Binding Color}" Width="80"/>
      <TextBox PlaceholderText="Обивка" Text="{Binding Upholstery}" Width="80"/>
      <TextBox PlaceholderText="Мощность" Text="{Binding MotorPower}" Width="120"/>
      <TextBox PlaceholderText="Дверей (число)" Text="{Binding DoorCount}" Width="90"/>
      <ComboBox SelectedItem="{Binding Transmission}" Width="130">
        <ComboBoxItem>механическая</ComboBoxItem>
        <ComboBoxItem>автоматическая</ComboBoxItem>
      </ComboBox>
    </StackPanel>

    <!-- Сообщение об ошибке -->
    <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red" Margin="10,0"/>

    <!-- Цена и поставщики -->
    <Grid Grid.Row="2" Margin="10" ColumnDefinitions="*,*">
      <StackPanel Grid.Column="0">
        <TextBlock Text="Ценовые показатели (у.е.):" FontWeight="Bold"/>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,0">
          <StackPanel>
            <TextBlock Text="Год выпуска" FontSize="11"/>
            <TextBox Text="{Binding YearOfManufacture}" Width="90"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Цена (у.е.)" FontSize="11"/>
            <TextBox Text="{Binding Price}" Width="90"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Подготовка (у.е.)" FontSize="11"/>
            <TextBox Text="{Binding PrepCost}" Width="110"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="Транспорт (у.е.)" FontSize="11"/>
            <TextBox Text="{Binding TransportCost}" Width="110"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
      
      <StackPanel Grid.Column="1">
        <TextBlock Text="Поставщики (Ctrl+клик для множественного):" FontWeight="Bold"/>
        <ListBox ItemsSource="{Binding Producers}" 
                 SelectionMode="Multiple"
                 Height="80">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding CompanyName}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Grid>

    <!-- Список моделей -->
    <ListBox Grid.Row="3" Margin="10"
             ItemsSource="{Binding Models}"
             ItemTemplate="{StaticResource modelTemplate}"
             SelectedItem="{Binding SelectedModel}"/>

    <!-- Кнопки -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="10" Spacing="10">
      <Button Content="Добавить" Command="{Binding AddCommand}"/>
      <Button Content="Удалить выбранную" Command="{Binding DeleteCommand}"/>
      <Button Content="Обновить" Command="{Binding RefreshCommand}"/>
    </StackPanel>

  </Grid>
</UserControl>